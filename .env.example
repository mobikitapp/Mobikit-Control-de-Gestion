# Flask Configuration
FLASK_ENV=development
DEBUG=True

# Session Secret (Required for Replit Auth)
SESSION_SECRET=your-super-secret-session-key-here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/manufacturing_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=manufacturing_db
PGUSER=user
PGPASSWORD=password

# Replit Auth Configuration (automatically provided in Replit)
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# File Upload Configuration
MAX_UPLOAD_MB=25
ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/jpg

# Storage Configuration (Replit Storage)
STORAGE_BASE_URL=https://storage.replit.com
STORAGE_BUCKET=manufacturing-app

# Application Configuration
TIMEZONE=America/Santiago

# Email Configuration (Optional)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# Security Configuration
# BCRYPT_LOG_ROUNDS=12
# JWT_SECRET_KEY=your-jwt-secret-key

# External API Keys (if needed)
# SOME_API_KEY=your-api-key-here

# Development/Production Flags
# TESTING=False
# SEND_EMAILS=True
# USE_RELOADER=True

# Cache Configuration (if using Redis)
# REDIS_URL=redis://localhost:6379/0
# CACHE_TYPE=redis

# Celery Configuration (if using background tasks)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Monitoring and Analytics (Optional)
# SENTRY_DSN=your-sentry-dsn
# GOOGLE_ANALYTICS_ID=your-ga-id

# Regional Configuration
LANGUAGE=es
LOCALE=es_CL.UTF-8
CURRENCY=CLP
